{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake --preset windows-x64",
            "group": "none",
            "problemMatcher": [],
            "detail": "Runs the initial CMake configuration with vcpkg."
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "cmake --build --preset vs-debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [ "CMake: Configure" ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake --build --preset vs-release",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake --build --preset vs-debug --target clean",
            "problemMatcher": []
        }
    ]
}